<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#09132B"
                android:centerColor="#0F2657"
                android:endColor="#0A193A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_arrow_emblem" />
</layer-list>
